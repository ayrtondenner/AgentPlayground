    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Main File",
            "type": "debugpy",
            "request": "launch",
            "module": "agent_playground",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Main File (--test)",
            "type": "debugpy",
            "request": "launch",
            "module": "agent_playground",
            "cwd": "${workspaceFolder}",
            "args": [
                "--test"
            ],
            "console": "integratedTerminal"
        }
    ]
}